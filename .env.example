# GEMINI_API_KEY: Required for Gemini AI API calls (OCR, IMEI extraction, and visual inspection).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side fallback for direct browser Gemini API integration.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Cloud Run / Web hosting.
APP_URL="https://your-app-domain.run.app"

# PORT: The port used by the server (default: 3000).
PORT=3000
