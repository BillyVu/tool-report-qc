POSTGRES_DB=tool_report_qc
POSTGRES_USER=tool_report_qc
POSTGRES_PASSWORD=replace-with-a-long-random-password
QC_ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Local tester/dev only. Do not expose this value in a public frontend build.
VITE_QC_ADMIN_API_KEY=replace-with-the-same-admin-key-for-local-testing-only
RABBITMQ_USER=tool_report_qc
RABBITMQ_PASSWORD=replace-with-a-long-random-password
WORKER_PREFETCH=2
GEMINI_API_KEY=replace-with-server-only-gemini-key
BOT_NAME=Vero
GEMINI_MODEL=gemini-2.5-flash
# Set below the verified per-project RPM in Google AI Studio.
GEMINI_MAX_RPM=10
GEMINI_CIRCUIT_COOLDOWN_MS=300000
PORT=3020
UPLOADS_DIR=/srv/tool-report-qc/uploads
